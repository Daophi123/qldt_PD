# Hướng dẫn tạo file .env

# Số cổng của PORT với BASE_URL phải giống nhau
PORT=4040

# development hoặc production
NODE_ENV=development
BASE_URL=http://localhost:4040

# Đường dẫn database
DB_STORAGE=./data/dbqldt.sqlite

# Sử dụng lệnh bên dưới vào terminal hoặc command prompt để generate chuỗi 64 ký tự ngấu nhiên JWT_SECRET and ENCRYPTION_SECRET_KEY
# console.log('JWT_SECRET=' + require('crypto').randomBytes(32).toString('hex'))
