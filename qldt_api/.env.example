ENCRYPTION_SECRET_KEY=63fcc59d3d1ada5b2a0454a041339cab93baf5e5fc5a2f56a5285a3e12bb363d

# Cho phép URL phía frontend có thể gọi API của backend
CORS_ORIGIN=http://localhost:3000